generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  passwordHash  String?     @map("password_hash")
  googleId      String?     @unique @map("google_id")
  steamId       String?     @unique @map("steam_id")
  role               Role        @default(USER)
  emailVerified      Boolean     @default(false) @map("email_verified")
  mustChangePassword Boolean     @default(false) @map("must_change_password")
  sessionVersion     Int         @default(1) @map("session_version")
  profile       Profile?
  tierLists     TierList[]
  builds        Build[]
  authTokens    AuthToken[]
  posts               Post[]
  postComments        PostComment[]
  postLikes           PostLike[]
  lfgPosts            LfgPost[]
  tournamentPicks     TournamentPick[]
  sentFriendships     Friendship[] @relation("FriendshipRequester")
  receivedFriendships Friendship[] @relation("FriendshipAddressee")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("users")
}

model AuthToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  payload   String?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("auth_tokens")
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username        String?  @unique
  handle          String?  @unique
  handleConfirmed Boolean  @default(false) @map("handle_confirmed")
  bio             String?
  avatarUrl      String?  @map("avatar_url")
  steamId        String?  @map("steam_id")
  favoriteHeroId Int?     @map("favorite_hero_id")
  bannerHeroId   Int?     @map("banner_hero_id")
  bannerImage    String?  @map("banner_image")
  bannerNsfw     Boolean  @default(false) @map("banner_nsfw")
  profileColor   String?  @map("profile_color")
  socialLinks    Json?    @map("social_links")
  friendsPublic  Boolean  @default(true) @map("friends_public")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model TierList {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title      String
  authorName String?  @map("author_name")
  style      String   @default("classic")
  tiers      Json
  quadrant   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("tier_lists")
}

model Build {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  heroId     Int      @map("hero_id")
  title      String
  authorName String?  @map("author_name")
  phases     Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([heroId, createdAt(sort: Desc)])
  @@map("builds")
}

model Post {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  mediaUrl  String?       @map("media_url")
  comments  PostComment[]
  likes     PostLike[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([createdAt(sort: Desc)])
  @@map("posts")
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([postId, createdAt])
  @@map("post_comments")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([postId, userId])
  @@map("post_likes")
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String           @map("requester_id")
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String           @map("addressee_id")
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendships")
}

model ExternalCache {
  key       String   @id
  source    String
  payload   Json
  fetchedAt DateTime @default(now()) @map("fetched_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("external_cache")
}

model LfgPost {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  region    String
  rankTier  String   @map("rank_tier")
  mode      String
  heroIds   Json     @map("hero_ids")
  note      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt(sort: Desc)])
  @@map("lfg_posts")
}

enum TournamentStatus {
  ONGOING
  UPCOMING
  FINISHED
}

model Tournament {
  id        String            @id @default(uuid())
  title     String
  region    String
  prizePool String?           @map("prize_pool")
  status    TournamentStatus  @default(UPCOMING)
  relevance Int               @default(0)
  startsAt  DateTime          @map("starts_at")
  teams     Json
  matches   TournamentMatch[]
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@index([status, relevance(sort: Desc)])
  @@map("tournaments")
}

model TournamentMatch {
  id           String           @id @default(uuid())
  tournamentId String           @map("tournament_id")
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  slot         Int
  teamA        String           @map("team_a")
  teamB        String           @map("team_b")
  scoreA       Int              @default(0) @map("score_a")
  scoreB       Int              @default(0) @map("score_b")
  winner       String?
  picks        TournamentPick[]

  @@index([tournamentId, round, slot])
  @@map("tournament_matches")
}

model TournamentPick {
  id         String          @id @default(uuid())
  matchId    String          @map("match_id")
  match      TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId     String          @map("user_id")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pickedTeam String          @map("picked_team")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@unique([matchId, userId])
  @@map("tournament_picks")
}

model LeaderboardSnapshot {
  accountId BigInt   @id @map("account_id")
  points    Int
  region    String?
  topHeroes Int[]    @default([]) @map("top_heroes")
  updatedAt DateTime @map("updated_at")

  @@index([points(sort: Desc), accountId])
  @@index([region, points(sort: Desc), accountId])
  @@index([topHeroes], type: Gin)
  @@map("leaderboard_snapshot")
}