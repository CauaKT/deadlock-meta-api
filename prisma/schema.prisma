generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  passwordHash  String?     @map("password_hash")
  googleId      String?     @unique @map("google_id")
  role               Role        @default(USER)
  emailVerified      Boolean     @default(false) @map("email_verified")
  mustChangePassword Boolean     @default(false) @map("must_change_password")
  sessionVersion     Int         @default(1) @map("session_version")
  profile       Profile?
  tierLists     TierList[]
  authTokens    AuthToken[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("users")
}

model AuthToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("auth_tokens")
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username       String?  @unique
  handle         String?  @unique
  bio            String?
  avatarUrl      String?  @map("avatar_url")
  steamId        String?  @map("steam_id")
  favoriteHeroId Int?     @map("favorite_hero_id")
  bannerHeroId   Int?     @map("banner_hero_id")
  bannerImage    String?  @map("banner_image")
  bannerNsfw     Boolean  @default(false) @map("banner_nsfw")
  profileColor   String?  @map("profile_color")
  socialLinks    Json?    @map("social_links")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model TierList {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title      String
  authorName String?  @map("author_name")
  tiers      Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("tier_lists")
}
